# Strava sync (optional). Create an API application at https://www.strava.com/settings/api
# and set its "Authorization Callback Domain" to your host (e.g. localhost for development).
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional: public URL used for canonical links, the sitemap and share images.
# Production builds default to https://m42.rinkleff.dev; set this only to override (e.g. preview deployments).
# NEXT_PUBLIC_SITE_URL=https://m42.rinkleff.dev
